# Copy to .env and fill in real values. Never commit .env itself.

# --- Backend ---
PORT=4000
NODE_ENV=development

# MongoDB — source of truth for users/projects/pipeline state
MONGO_URI=mongodb://localhost:27017/inkwell

# Redis — step-run locks + TTL-based stuck-state recovery only, never durable data
REDIS_URL=redis://localhost:6379

# JWT signing secret for session tokens (email+name identity, no password/OAuth)
JWT_SECRET=change-me-to-a-long-random-string

# Your own Gemini API key — https://ai.google.dev/ — never commit a real value
GEMINI_API_KEY=

# Local filesystem path for uploaded book text + generated images
STORAGE_DIR=./storage

# --- Frontend ---
# Base URL the Next.js app uses to reach the backend API
NEXT_PUBLIC_API_URL=http://localhost:4000
