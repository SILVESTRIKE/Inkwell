# Copy to .env and fill in real values. Never commit .env itself.

# --- Backend ---
PORT=4000
NODE_ENV=development

# MongoDB — source of truth for users/projects/pipeline state
MONGO_URI=mongodb://localhost:27017/inkwell
MONGO_URI_TEST=mongodb://localhost:27017/inkwell_isolated_test

# Redis — step-run locks + TTL-based stuck-state recovery only, never durable data
REDIS_URL=redis://localhost:6379

# JWT signing secret for session tokens (email+name identity, no password/OAuth)
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-long-refresh-random-string

# Your own Gemini API key(s) — https://ai.google.dev/ — supports single or comma-separated keys for round-robin rotation
GEMINI_API_KEY=
GEMINI_API_KEYS=key1,key2,key3

# Local filesystem path for uploaded book text + generated images
STORAGE_DIR=./uploads

# Cap limits for server-side generation bounds (assessment default: 2 adult characters, 1 chapter illustration)
MAX_CHARACTERS=2
MAX_CHAPTERS=1